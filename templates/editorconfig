root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python matches the Python seed formatter; keep it explicit rather than
# relying on the fallback indentation above. Stubs follow the same convention.
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

[*.pyi]
indent_style = space
indent_size = 4
max_line_length = 88

[*.md]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.toml]
indent_size = 2

[*.{html,css,js,jsx,ts,tsx}]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4
tab_width = 4
